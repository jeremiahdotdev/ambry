{
    "installCommand": "corepack enable && pnpm install --no-frozen-lockfile",
    "buildCommand": "rm -f public/hot public/fonts-manifest.dev.json public/index.php && pnpm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
