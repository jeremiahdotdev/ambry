{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?route=/"
    },
    {
      "source": "/health",
      "destination": "/api/index?route=/health"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index?route=/openapi.json"
    },
    {
      "source": "/openapi.yaml",
      "destination": "/api/index?route=/openapi.yaml"
    },
    {
      "source": "/schemas/:path*",
      "destination": "/api/index?route=/schemas/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index?route=/api/v1/:path*"
    }
  ]
}
